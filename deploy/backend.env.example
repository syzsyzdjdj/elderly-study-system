# 复制到 /etc/elderly-study/backend.env，填入新值，并设置 root:root 0600。
# 此文件由 systemd 读取，不是自动加载的 .env；不包含真实凭据。
DB_URL=jdbc:mysql://127.0.0.1:3306/elderly_study?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
DB_USERNAME=elderly_app
DB_PASSWORD=
DB_MIGRATIONS_ENABLED=true
DB_MIGRATION_USERNAME=elderly_migrator
DB_MIGRATION_PASSWORD=
# 使用随机生成的至少32字节密钥，例如 openssl rand -hex 32。
JWT_SECRET=
# 首次部署临时启用；用户名3-50位字母/数字/下划线，密码至少12字符。
# 管理员创建成功后改回 false，并移除用户名和密码值。
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
QWEATHER_API_HOST=
QWEATHER_API_KEY=
UPLOAD_DIR=/var/lib/elderly-study/uploads
SPARK_EXPORT_DIR=/var/lib/elderly-study/spark-tmp
LOG_FILE=/var/log/elderly-study/backend.log
SPARK_MODE=local
SPARK_MASTER=local[2]
TTS_MODE=http
TTS_API_URL=http://127.0.0.1:5050/generate
TTS_STARTUP_WARMUP=true
TTS_PREWARM_ON_STARTUP=true
TTS_CACHE_VERSION=v1
# 同源 Web 留空；原生应用按实际情况显式列出来源，多个来源用逗号分隔。
CORS_ALLOWED_ORIGINS=
